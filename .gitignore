# Rust / Cargo
target/

# Node / desktop build output
node_modules/
dist/
build/
coverage/

# Logs and local environment
*.log
.env
.envrc

# Scan-kit test data (local only, not shipped)
test_data/

# CI bundle staging (do not re-commit frozen binaries)
*.exe
scan-kit-windows/
scan-kit-linux/

# Cursor
#  `.cursorignore` excludes files/directories from AI features.
.cursorignore
.cursorindexingignore

# AI scratch: throwaway diagnostic/analysis scripts the assistant writes while
# reasoning. Everything here is ignored except the README that documents it.
/ai-scratch/*
!/ai-scratch/README.md
