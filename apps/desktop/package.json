{
  "name": "scan-kit-desktop",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "wasm": "cargo build -p scan-kit-plot --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir src/wasm ../../target/wasm32-unknown-unknown/release/scan_kit_plot.wasm",
    "dev": "node scripts/dev-server.mjs",
    "build": "npm run wasm && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/keep-up.test.mjs",
    "lint": "oxlint",
    "knip": "knip",
    "tauri": "node scripts/tauri.mjs",
    "screenshots": "node scripts/capture-doc-screenshots.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@glideapps/glide-data-grid": "^6.0.4-alpha24",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.0",
    "oxlint": "^1.93.0",
    "shadcn": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
