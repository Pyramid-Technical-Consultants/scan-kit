{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    // Copied shadcn components. Leave them as `npx shadcn add` wrote them.
    // Generated src/wasm is gitignored, which Knip already skips.
    "src/components/ui/**"
  ],
  // wasm-bindgen is the CLI pinned in Cargo.lock. rustc reports the host triple for the MCP sidecar.
  "ignoreBinaries": ["wasm-bindgen", "rustc"],
  // scripts/tauri.mjs spawns this package's tauri.js by path, so the bin is unused.
  "ignoreDependencies": [
    "@tauri-apps/cli"
  ]
}
