{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Scan Kit",
      "type": "shell",
      "command": "npm",
      "args": ["run", "tauri", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/apps/desktop"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Tests (cargo)",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--workspace", "--exclude", "scan-kit-desktop", "--locked"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "MC Validate (fast)",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "-p", "scan-kit-compute", "--bin", "mc-validate", "--", "fast"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build Installer",
      "type": "shell",
      "command": "npm",
      "args": ["run", "tauri", "build"],
      "options": {
        "cwd": "${workspaceFolder}/apps/desktop"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
