{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Scan Kit",
      "type": "shell",
      "command": "python",
      "args": ["-m", "scan_kit"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Tests (fast)",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pytest"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Tests (full)",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pytest", "-o", "addopts=-ra"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Tests (parallel)",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pytest", "-n", "auto", "--dist", "loadscope"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Install (editable)",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pip", "install", "-e", ".[build,dev]"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build Executable",
      "type": "shell",
      "command": "python",
      "args": ["build.py", "--clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
